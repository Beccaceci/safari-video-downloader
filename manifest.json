{
  "manifest_version": 3,
  "name": "Safari Video Downloader",
  "version": "1.0.0",
  "description": "Download videos from hyperlinks and streaming players, including Portale della Didattica, direct MP4s, and HLS streams.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Safari Video Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/content-bridge.js",
        "content/polito-adapter.js",
        "content/youtube-adapter.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/main-world-interceptor.js",
        "content/youtube-interceptor.js",
        "downloader/hls-downloader.html",
        "downloader/hls-downloader.js",
        "downloader/hls-downloader.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
